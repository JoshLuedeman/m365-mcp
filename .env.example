# =============================================================================
# m365-mcp Environment Variables
# =============================================================================

# Auth mode: 'device_code' (default, personal use) or 'client_credentials' (server/agent use)
M365_AUTH_MODE=device_code

# ---------------------------------------------------------------------------
# Device code auth (device_code mode — default)
# Override the shared app registration for enterprise use
# ---------------------------------------------------------------------------
# M365_MCP_CLIENT_ID=your-client-id
# M365_MCP_TENANT_ID=your-tenant-id

# ---------------------------------------------------------------------------
# Client credentials auth (client_credentials mode — server/agent use)
# Requires an Azure App Registration with Application permissions (not Delegated)
# ---------------------------------------------------------------------------
M365_CLIENT_ID=your-client-id
M365_CLIENT_SECRET=your-client-secret
M365_TENANT_ID=your-tenant-id

# Default mailbox for client_credentials mode (optional — can be passed per-call via the mailbox param)
# M365_MAILBOX=you@yourdomain.com

# ---------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------

# Webhook port (Phase C)
M365_MCP_PORT=3847

# Rules file path (Phase B)
# M365_MCP_RULES_PATH=/path/to/your/rules.yaml
